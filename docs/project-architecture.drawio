        <mxCell id="p4-data5" value="典型插件实例&#xa;source: local-filesystem / source-netease-cloud-music&#xa;service: service-downloader / service-provider-*&#xa;library-kind: library-asmr / library-netease-cloud-music&#xa;tool page: api-playground / file-manager / eagle-importer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbefff;strokeColor=#bf3989;fontColor=#6e1b50;arcSize=8;" vertex="1" parent="p4-data-lane">
