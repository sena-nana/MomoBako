  <diagram id="plugins-external" name="04 插件与外部生态">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p4-title" value="插件架构与外部集成生态" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1f2328;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="720" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="p4-plugin-src" value="插件源码工程&#xa;External/Plugins/*&#xa;每个插件独立 manifest.json / plugin.project.json&#xa;frontend-module / cargo-native / manifest-only&#xa;根仓库脚本仅转发构建、打包、stage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbefff;strokeColor=#bf3989;fontColor=#6e1b50;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="330" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p4-build" value="插件工具链&#xa;External/Plugins/scripts/build.mjs&#xa;package.mjs / stage-dev.mjs&#xa;_sdk/backend-rust&#xa;template / example" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbefff;strokeColor=#bf3989;fontColor=#6e1b50;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="110" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p4-package" value=".momoplug 包&#xa;物理格式 zip，扩展名固定 .momoplug&#xa;单插件根目录 / manifest.json&#xa;dist/register.js 或 backend dylib&#xa;安装时复制，不持久解压" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbefff;strokeColor=#bf3989;fontColor=#6e1b50;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="110" width="320" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p4-runtime-dir" value="运行时插件目录&#xa;&lt;serviceRoot&gt;/plugins/*.momoplug&#xa;宿主启动与 GET /plugins 扫描&#xa;manifest 直读，删除/新增直接反映" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbefff;strokeColor=#bf3989;fontColor=#6e1b50;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="110" width="320" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="p4-categories" value="Manifest 分类与职责" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=32;fillColor=#f6f8fa;strokeColor=#8c959f;fontColor=#24292f;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="700" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="p4-c1" value="source&#xa;仓库 IO 后端&#xa;local-filesystem / webdav / cloud-drive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#54aeef;fontColor=#0969da;arcSize=8;" vertex="1" parent="p4-categories">
          <mxGeometry x="30" y="60" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p4-c2" value="library-kind&#xa;资源语义、字段、视图、搜索快捷方式&#xa;image/audio/video/asmr/manga/font/model3d..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#54aeef;fontColor=#0969da;arcSize=8;" vertex="1" parent="p4-categories">
          <mxGeometry x="250" y="60" width="200" height="80" as="geometry"/>
