  <diagram id="plugins-external" name="04 插件代码架构">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p4-title" value="插件代码架构：Manifest、宿主 SDK、原生 ABI 与数据目录" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1f2328;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="980" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="p4-note" value="当前插件系统以 `.momoplug` 为统一交付物。宿主保持包级扫描、按需加载和核心写路径收口；插件负责贡献 UI、后端能力、仓库 IO、元数据候选、播放类型和工具页。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#d0d7de;fontColor=#57606a;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="76" width="1860" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="p4-plugin-src" value="插件源码工程&#xa;External/Plugins/*&#xa;manifest.json + register.js 或 src/lib.rs&#xa;source / library-kind / parser / preview / service&#xa;每个插件独立构建与依赖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbefff;strokeColor=#bf3989;fontColor=#6e1b50;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p4-build" value="插件工具链&#xa;External/Plugins/scripts/build.mjs&#xa;package.mjs / stage-dev.mjs / _sdk/backend-rust&#xa;dev 模式可直接 stage 到 runtime plugins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbefff;strokeColor=#bf3989;fontColor=#6e1b50;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="170" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p4-package" value=".momoplug 统一包&#xa;zip 容器，扩展名固定 .momoplug&#xa;manifest.json + dist/register.js 或 backend dylib&#xa;安装复制，运行时直接读 archive，避免常驻解压目录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbefff;strokeColor=#bf3989;fontColor=#6e1b50;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="170" width="330" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p4-runtime-dir" value="运行时插件目录&#xa;&lt;serviceRoot&gt;/plugins/*.momoplug&#xa;宿主启动与 `list_plugins` 按包扫描&#xa;manifest 直读，新增/删除直接反映到管理页与前端注册表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbefff;strokeColor=#bf3989;fontColor=#6e1b50;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1170" y="170" width="350" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p4-manifest" value="Manifest 契约&#xa;pluginId / legacyPluginIds / version / kind / category&#xa;sdk / runtime / entry / permissions / requires / optional&#xa;hooks / contributes / compat / status / dependencyStatus&#xa;settings.fields / settingsPage / toolPages / playlistPlayers / apiTests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#24292f;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1580" y="170" width="320" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="p4-frontend-lane" value="前端 vue-module 宿主" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=32;fillColor=#f6f8fa;strokeColor=#8c959f;fontColor=#24292f;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="920" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="p4-fe1" value="插件清单同步&#xa;src/services/repositoryApi/plugins.ts:listPlugins&#xa;src/plugins/sdk.ts:syncRegisteredPreviewPluginManifests&#xa;根据 manifest 启用/禁用、更新 registryVersion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2f6feb;fontColor=#0a3069;arcSize=8;fontStyle=1;" vertex="1" parent="p4-frontend-lane">
          <mxGeometry x="30" y="60" width="270" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p4-fe2" value="包内模块按需读取&#xa;read_plugin_archive_text(pluginId, path)&#xa;data:text/javascript URL&#xa;dynamic import(register export)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2f6feb;fontColor=#0a3069;arcSize=8;" vertex="1" parent="p4-frontend-lane">
          <mxGeometry x="330" y="60" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p4-fe3" value="FrontendPluginContext&#xa;registerPreview / registerPlaylistPlayer / registerLibraryExtension&#xa;registerToolPage / registerSettingsPage / registerEntryActionProvider&#xa;getPluginConfig / getPluginDataDirectory / callPlugin / onPluginEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2f6feb;fontColor=#0a3069;arcSize=8;" vertex="1" parent="p4-frontend-lane">
          <mxGeometry x="610" y="60" width="270" height="110" as="geometry"/>
        </mxCell>
