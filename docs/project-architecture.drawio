          <mxGeometry x="470" y="60" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p4-c4" value="preview&#xa;预览与缩略图&#xa;media / text / three-model / office" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#54aeef;fontColor=#0969da;arcSize=8;" vertex="1" parent="p4-categories">
          <mxGeometry x="140" y="185" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p4-c5" value="service&#xa;外部能力与后台服务&#xa;metadata providers / downloader / network-search / vector-index / watcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#54aeef;fontColor=#0969da;arcSize=8;" vertex="1" parent="p4-categories">
