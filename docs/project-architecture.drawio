        <mxCell id="p4-data3" value="仓库核心落点&#xa;repositories.db 全局注册表&#xa;repo/.momo/repository.json / metadata.db / thumbnails / indexes&#xa;用户文件保持原位，插件写入经过宿主路径检查与 revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#2da44e;fontColor=#116329;arcSize=8;" vertex="1" parent="p4-data-lane">
