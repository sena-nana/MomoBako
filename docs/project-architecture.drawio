  <diagram id="contracts-verification" name="05 契约与验证">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p5-title" value="数据契约、构建链路与验证面" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1f2328;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="620" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="p5-contract" value="跨端数据契约" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=32;fillColor=#f6f8fa;strokeColor=#8c959f;fontColor=#24292f;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="660" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="p5-types" value="src/types/repository.ts&#xa;前端 TS 类型&#xa;RepositorySummary / Snapshot / FileBrowserEntry&#xa;Search / SmartFolder / Playlist / PluginManifest&#xa;External API / Cache / Revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2f6feb;fontColor=#0a3069;arcSize=8;fontStyle=1;" vertex="1" parent="p5-contract">
          <mxGeometry x="40" y="70" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p5-rust-types" value="repository_service.rs&#xa;Rust serde structs&#xa;Tauri command request/response&#xa;SQLite 映射与 schema migration&#xa;插件 manifest / dependency status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#cf222e;fontColor=#82071e;arcSize=8;fontStyle=1;" vertex="1" parent="p5-contract">
          <mxGeometry x="360" y="70" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p5-docs" value="docs/api-design.md&#xa;外部 API + Repository API&#xa;Asset / Metadata / Search / Smart Folder&#xa;Plugin / Cache 契约&#xa;变更时与 TS/Rust 同步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#24292f;arcSize=8;" vertex="1" parent="p5-contract">
          <mxGeometry x="200" y="240" width="250" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="p5-build" value="构建与脚本" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=32;fillColor=#f6f8fa;strokeColor=#8c959f;fontColor=#24292f;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="110" width="660" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="p5-b1" value="开发&#xa;yarn dev → Vite dev server:1420&#xa;yarn tauri:dev → scripts/tauri-dev.mjs&#xa;yarn tauri:dev:with-plugins → build/package/stage plugins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e5;strokeColor=#fb8f44;fontColor=#9a3412;arcSize=8;" vertex="1" parent="p5-build">
          <mxGeometry x="40" y="70" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p5-b2" value="前端构建&#xa;yarn build&#xa;vue-tsc --noEmit + vite build&#xa;manualChunks 拆出 three / vrm 预览依赖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e5;strokeColor=#fb8f44;fontColor=#9a3412;arcSize=8;" vertex="1" parent="p5-build">
          <mxGeometry x="360" y="70" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p5-b3" value="桌面构建&#xa;yarn tauri:build&#xa;tauri.conf.json&#xa;dist + Rust binary + icons&#xa;protocol-asset 允许 .momo/thumbnails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e5;strokeColor=#fb8f44;fontColor=#9a3412;arcSize=8;" vertex="1" parent="p5-build">
          <mxGeometry x="40" y="220" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p5-b4" value="插件产物&#xa;yarn plugins:build/package/stage:dev&#xa;External/Plugins/.dist&#xa;External/Plugins/.packages/*.momoplug&#xa;复制到 runtime plugins/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e5;strokeColor=#fb8f44;fontColor=#9a3412;arcSize=8;" vertex="1" parent="p5-build">
          <mxGeometry x="360" y="220" width="260" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="p5-verify" value="验证面" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=32;fillColor=#f6f8fa;strokeColor=#8c959f;fontColor=#24292f;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="1410" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="p5-v1" value="yarn test&#xa;Vitest + jsdom + Testing Library&#xa;router / theme / tooling&#xa;file browser / drag behavior / metadata editor&#xa;preview plugins / media / 3D / playlist / plugin manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#2da44e;fontColor=#116329;arcSize=8;fontStyle=1;" vertex="1" parent="p5-verify">
          <mxGeometry x="40" y="70" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p5-v2" value="yarn build&#xa;TypeScript + Vue SFC 类型检查&#xa;Vite 生产构建&#xa;前端入口、按需组件和依赖拆包验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#2da44e;fontColor=#116329;arcSize=8;" vertex="1" parent="p5-verify">
          <mxGeometry x="390" y="70" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p5-v3" value="cargo check --manifest-path src-tauri/Cargo.toml&#xa;Rust/Tauri 编译检查&#xa;repository_service/runtime/window_state&#xa;依赖 crate 与命令签名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#2da44e;fontColor=#116329;arcSize=8;" vertex="1" parent="p5-verify">
          <mxGeometry x="740" y="70" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p5-v4" value="yarn verify&#xa;串行执行 test → build → cargo check&#xa;适用于逻辑调整、公共模块、持久化、Tauri 命令、关键路径改动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#2da44e;fontColor=#116329;arcSize=8;fontStyle=1;" vertex="1" parent="p5-verify">
          <mxGeometry x="1090" y="70" width="280" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p5-rule" value="AGENTS.md 变更顺序提示&#xa;跨端数据模型：先改 src/types/repository.ts 与 docs/api-design.md，再同步 repositoryApi.ts、repository_service.rs 和相关测试。&#xa;文档/图示低风险改动通常无需跑完整构建，但需确认文件可用。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#d4a72c;fontColor=#3d2d00;arcSize=8;" vertex="1" parent="p5-verify">
          <mxGeometry x="210" y="230" width="960" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="p5-e1" value="双向同步" style="endArrow=block;startArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#57606a;" edge="1" parent="p5-contract" source="p5-types" target="p5-rust-types">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p5-e2" value="文档契约" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#57606a;" edge="1" parent="p5-contract" source="p5-docs" target="p5-types">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p5-e3" value="文档契约" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#57606a;" edge="1" parent="p5-contract" source="p5-docs" target="p5-rust-types">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p5-e4" value="verify 包含" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2da44e;" edge="1" parent="1" source="p5-v4" target="p5-v1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p5-e5" value="verify 包含" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2da44e;" edge="1" parent="1" source="p5-v4" target="p5-v2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p5-e6" value="verify 包含" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2da44e;" edge="1" parent="1" source="p5-v4" target="p5-v3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="plugin-design-notes" name="06 插件设计与说明">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p6-title" value="插件设计原则、运行顺序与说明" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1f2328;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="760" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="p6-note" value="这一页把第 4 页的结构图拆成设计原则和运行说明，方便在评审、开发接入和插件排障时快速定位边界。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#d0d7de;fontColor=#57606a;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="76" width="1700" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="p6-principles" value="设计原则" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=32;fillColor=#f6f8fa;strokeColor=#8c959f;fontColor=#24292f;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="1700" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="p6-p1" value="统一交付物&#xa;.momoplug 同时承载 manifest、前端模块、原生库&#xa;发布、安装、版本回滚都围绕单包进行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbefff;strokeColor=#bf3989;fontColor=#6e1b50;arcSize=8;fontStyle=1;" vertex="1" parent="p6-principles">
          <mxGeometry x="30" y="70" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p6-p2" value="声明先行&#xa;manifest 描述 category、runtime、依赖、hooks、settings、toolPages、playlistPlayers&#xa;宿主据此决定加载路径和 UI 呈现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2f6feb;fontColor=#0a3069;arcSize=8;" vertex="1" parent="p6-principles">
          <mxGeometry x="360" y="70" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p6-p3" value="配置与数据由宿主管理&#xa;config.json、pluginDataDir、enabled 状态、native cache 都在 .service-data 下统一落盘&#xa;迁移、备份和排障路径稳定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#2da44e;fontColor=#116329;arcSize=8;" vertex="1" parent="p6-principles">
          <mxGeometry x="690" y="70" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p6-p4" value="核心收口危险写路径&#xa;revision、审计、批量整理、删除/移动、下载落盘和 metadata 写入由宿主执行&#xa;插件负责候选、声明、算法和局部 UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#d4a72c;fontColor=#3d2d00;arcSize=8;fontStyle=1;" vertex="1" parent="p6-principles">
          <mxGeometry x="1020" y="70" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p6-p5" value="前后端对称扩展&#xa;前端通过 FrontendPluginContext 注册 UI 能力&#xa;后端通过 C ABI + JSON envelope 暴露服务能力&#xa;source 插件继续走 RepositoryState 调度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#cf222e;fontColor=#82071e;arcSize=8;" vertex="1" parent="p6-principles">
          <mxGeometry x="1370" y="70" width="280" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="p6-flow" value="运行顺序" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=32;fillColor=#f6f8fa;strokeColor=#8c959f;fontColor=#24292f;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1700" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="p6-f1" value="1. 扫描 runtime plugins/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#24292f;arcSize=8;fontStyle=1;" vertex="1" parent="p6-flow">
          <mxGeometry x="30" y="90" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p6-f2" value="2. 读取 manifest&#xa;归一化 legacy ID 与 category&#xa;计算 dependencyStatus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#24292f;arcSize=8;" vertex="1" parent="p6-flow">
          <mxGeometry x="260" y="90" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p6-f3" value="3. 前端插件走 read_plugin_archive_text + dynamic import" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2f6feb;fontColor=#0a3069;arcSize=8;" vertex="1" parent="p6-flow">
          <mxGeometry x="510" y="90" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p6-f4" value="4. 后端插件按需抽取 dylib + libloading + host API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#cf222e;fontColor=#82071e;arcSize=8;" vertex="1" parent="p6-flow">
          <mxGeometry x="780" y="90" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p6-f5" value="5. 注册 UI 与服务贡献&#xa;preview / player / library / tool / settings / actions / providers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbefff;strokeColor=#bf3989;fontColor=#6e1b50;arcSize=8;" vertex="1" parent="p6-flow">
          <mxGeometry x="1060" y="90" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p6-f6" value="6. 宿主页面与命令消费贡献&#xa;UI 查注册表，ViewModel 走 RepositoryState / call_plugin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e5;strokeColor=#fb8f44;fontColor=#9a3412;arcSize=8;" vertex="1" parent="p6-flow">
          <mxGeometry x="1340" y="90" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p6-f7" value="7. 配置、缓存、helper 状态持久化到 .service-data；仓库写入走 revision/audit 路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#2da44e;fontColor=#116329;arcSize=8;fontStyle=1;" vertex="1" parent="p6-flow">
          <mxGeometry x="620" y="180" width="470" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p6-e1" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#57606a;" edge="1" parent="p6-flow" source="p6-f1" target="p6-f2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p6-e2" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2f6feb;" edge="1" parent="p6-flow" source="p6-f2" target="p6-f3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p6-e3" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#cf222e;" edge="1" parent="p6-flow" source="p6-f3" target="p6-f4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p6-e4" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#bf3989;" edge="1" parent="p6-flow" source="p6-f4" target="p6-f5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p6-e5" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#fb8f44;" edge="1" parent="p6-flow" source="p6-f5" target="p6-f6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p6-e6" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2da44e;" edge="1" parent="p6-flow" source="p6-f6" target="p6-f7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="p6-map" value="贡献点速查" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=32;fillColor=#f6f8fa;strokeColor=#8c959f;fontColor=#24292f;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1700" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="p6-m1" value="preview&#xa;宿主入口: registerPreview&#xa;主要页面: FilePreviewPane&#xa;典型能力: 预览组件、缩略图、文件动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2f6feb;fontColor=#0a3069;arcSize=8;" vertex="1" parent="p6-map">
          <mxGeometry x="30" y="70" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p6-m2" value="library-kind&#xa;宿主入口: registerLibraryExtension&#xa;主要页面: MetadataEditor / Search / Playlist&#xa;典型能力: 字段语义、搜索捷径、summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2f6feb;fontColor=#0a3069;arcSize=8;" vertex="1" parent="p6-map">
          <mxGeometry x="310" y="70" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p6-m3" value="tool / settings / actions&#xa;宿主入口: registerToolPage / registerSettingsPage / registerEntryActionProvider&#xa;主要页面: ExtensionsPanel / PluginManagerPanel / ContextMenu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2f6feb;fontColor=#0a3069;arcSize=8;" vertex="1" parent="p6-map">
          <mxGeometry x="590" y="70" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p6-m4" value="source&#xa;宿主入口: BackendPluginRegistry + filesystem backend delegation&#xa;主要模块: sync / browser / importing / playback&#xa;典型能力: listFiles、read、move、watch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#cf222e;fontColor=#82071e;arcSize=8;" vertex="1" parent="p6-map">
          <mxGeometry x="920" y="70" width="270" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p6-m5" value="provider / parser / service&#xa;宿主入口: call_plugin / metadata defaults / hook executions&#xa;主要模块: api_design / playlist / metadata sync / downloader&#xa;典型能力: provider.lookupMetadataCandidate、下载、转换、候选默认值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#cf222e;fontColor=#82071e;arcSize=8;" vertex="1" parent="p6-map">
          <mxGeometry x="1220" y="70" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p6-m6" value="排障优先顺序&#xa;1. 先看 manifest 与 dependencyStatus&#xa;2. 再看 plugin-state.json / config.json / plugin-data&#xa;3. 前端问题查 registryVersion 与 read_plugin_archive_text&#xa;4. 后端问题查 plugin-cache、C ABI 导出和 host API 调用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#d4a72c;fontColor=#3d2d00;arcSize=8;fontStyle=1;" vertex="1" parent="p6-map">
          <mxGeometry x="470" y="220" width="760" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
