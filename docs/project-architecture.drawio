  <diagram id="contracts-verification" name="05 契约与验证">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p5-title" value="数据契约、构建链路与验证面" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1f2328;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="620" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="p5-contract" value="跨端数据契约" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=32;fillColor=#f6f8fa;strokeColor=#8c959f;fontColor=#24292f;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="660" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="p5-types" value="src/types/repository.ts&#xa;前端 TS 类型&#xa;RepositorySummary / Snapshot / FileBrowserEntry&#xa;Search / SmartFolder / Playlist / PluginManifest&#xa;External API / Cache / Revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2f6feb;fontColor=#0a3069;arcSize=8;fontStyle=1;" vertex="1" parent="p5-contract">
          <mxGeometry x="40" y="70" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p5-rust-types" value="repository_service.rs&#xa;Rust serde structs&#xa;Tauri command request/response&#xa;SQLite 映射与 schema migration&#xa;插件 manifest / dependency status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#cf222e;fontColor=#82071e;arcSize=8;fontStyle=1;" vertex="1" parent="p5-contract">
          <mxGeometry x="360" y="70" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p5-docs" value="docs/api-design.md&#xa;外部 API + Repository API&#xa;Asset / Metadata / Search / Smart Folder&#xa;Plugin / Cache 契约&#xa;变更时与 TS/Rust 同步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#24292f;arcSize=8;" vertex="1" parent="p5-contract">
          <mxGeometry x="200" y="240" width="250" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="p5-build" value="构建与脚本" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=32;fillColor=#f6f8fa;strokeColor=#8c959f;fontColor=#24292f;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="110" width="660" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="p5-b1" value="开发&#xa;yarn dev → Vite dev server:1420&#xa;yarn tauri:dev → scripts/tauri-dev.mjs&#xa;yarn tauri:dev:with-plugins → build/package/stage plugins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e5;strokeColor=#fb8f44;fontColor=#9a3412;arcSize=8;" vertex="1" parent="p5-build">
          <mxGeometry x="40" y="70" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p5-b2" value="前端构建&#xa;yarn build&#xa;vue-tsc --noEmit + vite build&#xa;manualChunks 拆出 three / vrm 预览依赖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e5;strokeColor=#fb8f44;fontColor=#9a3412;arcSize=8;" vertex="1" parent="p5-build">
          <mxGeometry x="360" y="70" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p5-b3" value="桌面构建&#xa;yarn tauri:build&#xa;tauri.conf.json&#xa;dist + Rust binary + icons&#xa;protocol-asset 允许 .momo/thumbnails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e5;strokeColor=#fb8f44;fontColor=#9a3412;arcSize=8;" vertex="1" parent="p5-build">
          <mxGeometry x="40" y="220" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p5-b4" value="插件产物&#xa;yarn plugins:build/package/stage:dev&#xa;External/Plugins/.dist&#xa;External/Plugins/.packages/*.momoplug&#xa;复制到 runtime plugins/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e5;strokeColor=#fb8f44;fontColor=#9a3412;arcSize=8;" vertex="1" parent="p5-build">
          <mxGeometry x="360" y="220" width="260" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="p5-verify" value="验证面" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=32;fillColor=#f6f8fa;strokeColor=#8c959f;fontColor=#24292f;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="1410" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="p5-v1" value="yarn test&#xa;Vitest + jsdom + Testing Library&#xa;router / theme / tooling&#xa;file browser / drag behavior / metadata editor&#xa;preview plugins / media / 3D / playlist / plugin manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#2da44e;fontColor=#116329;arcSize=8;fontStyle=1;" vertex="1" parent="p5-verify">
          <mxGeometry x="40" y="70" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p5-v2" value="yarn build&#xa;TypeScript + Vue SFC 类型检查&#xa;Vite 生产构建&#xa;前端入口、按需组件和依赖拆包验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#2da44e;fontColor=#116329;arcSize=8;" vertex="1" parent="p5-verify">
          <mxGeometry x="390" y="70" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p5-v3" value="cargo check --manifest-path src-tauri/Cargo.toml&#xa;Rust/Tauri 编译检查&#xa;repository_service/runtime/window_state&#xa;依赖 crate 与命令签名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#2da44e;fontColor=#116329;arcSize=8;" vertex="1" parent="p5-verify">
          <mxGeometry x="740" y="70" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p5-v4" value="yarn verify&#xa;串行执行 test → build → cargo check&#xa;适用于逻辑调整、公共模块、持久化、Tauri 命令、关键路径改动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#2da44e;fontColor=#116329;arcSize=8;fontStyle=1;" vertex="1" parent="p5-verify">
          <mxGeometry x="1090" y="70" width="280" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p5-rule" value="AGENTS.md 变更顺序提示&#xa;跨端数据模型：先改 src/types/repository.ts 与 docs/api-design.md，再同步 repositoryApi.ts、repository_service.rs 和相关测试。&#xa;文档/图示低风险改动通常无需跑完整构建，但需确认文件可用。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#d4a72c;fontColor=#3d2d00;arcSize=8;" vertex="1" parent="p5-verify">
          <mxGeometry x="210" y="230" width="960" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="p5-e1" value="双向同步" style="endArrow=block;startArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#57606a;" edge="1" parent="p5-contract" source="p5-types" target="p5-rust-types">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p5-e2" value="文档契约" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#57606a;" edge="1" parent="p5-contract" source="p5-docs" target="p5-types">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p5-e3" value="文档契约" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#57606a;" edge="1" parent="p5-contract" source="p5-docs" target="p5-rust-types">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p5-e4" value="verify 包含" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2da44e;" edge="1" parent="1" source="p5-v4" target="p5-v1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p5-e5" value="verify 包含" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2da44e;" edge="1" parent="1" source="p5-v4" target="p5-v2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p5-e6" value="verify 包含" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2da44e;" edge="1" parent="1" source="p5-v4" target="p5-v3">
