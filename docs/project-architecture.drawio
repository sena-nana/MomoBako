        <mxCell id="p4-be9" value="核心收口边界&#xa;revision / audit / dangerous writes / batch organize / candidate merge / download queue 由宿主拥有&#xa;插件提供声明、候选与局部 UI，核心持有确认和持久化责任" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#d4a72c;fontColor=#3d2d00;arcSize=8;fontStyle=1;" vertex="1" parent="p4-backend-lane">
