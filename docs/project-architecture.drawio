        <mxCell id="p4-be1" value="BackendPluginRegistry::load / load_for_management&#xa;扫描 &lt;serviceRoot&gt;/plugins/*.momoplug&#xa;读取 manifest，规范 legacyPluginIds 和 category&#xa;应用 plugin-state.json enabled 状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#cf222e;fontColor=#82071e;arcSize=8;fontStyle=1;" vertex="1" parent="p4-backend-lane">
