        <mxCell id="p4-f1" value="GET /plugins&#xa;RepositoryState 读取 manifest&#xa;解析 legacy IDs / dependencyStatus / enabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#24292f;arcSize=8;" vertex="1" parent="p4-flow">
          <mxGeometry x="30" y="60" width="190" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="p4-f2" value="前端 vue-module&#xa;read_plugin_archive_text&#xa;data:text/javascript URL&#xa;dynamic import + register(ctx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#24292f;arcSize=8;" vertex="1" parent="p4-flow">
          <mxGeometry x="255" y="60" width="190" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="p4-f3" value="注册表生效&#xa;previewPluginRegistry&#xa;playlistPlayerRegistry&#xa;libraryExtensionRegistry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#24292f;arcSize=8;" vertex="1" parent="p4-flow">
          <mxGeometry x="480" y="60" width="190" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="p4-f4" value="后端 native-dylib&#xa;从包内提取到受控临时缓存&#xa;libloading 加载" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#24292f;arcSize=8;" vertex="1" parent="p4-flow">
          <mxGeometry x="140" y="190" width="190" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="p4-f5" value="C ABI + JSON envelope&#xa;momobako_plugin_manifest&#xa;momobako_plugin_call&#xa;momobako_plugin_free" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#24292f;arcSize=8;" vertex="1" parent="p4-flow">
          <mxGeometry x="370" y="190" width="190" height="84" as="geometry"/>
        </mxCell>

        <mxCell id="p4-browser" value="浏览器采集扩展&#xa;Manifest V3 service-worker&#xa;contextMenus image/link&#xa;读取 baseUrl/token/repoId/parentPath&#xa;POST /external/v1/assets:add" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#d4a72c;fontColor=#3d2d00;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="330" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p4-external-api" value="MomoBako 外部 API&#xa;127.0.0.1 + 启动生成 bearer token&#xa;health / repositories / assets:add&#xa;remoteUrl 下载 → 本地导入 → metadata 写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#cf222e;fontColor=#82071e;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="760" width="340" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p4-eagle" value="EagleLibraryChanger&#xa;读取 Eagle metadata/tags/actions/images&#xa;输出 .momo/repository.json + metadata.db&#xa;迁移 tagsGroups / quickAccess / smartFolders / actions / trash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#d4a72c;fontColor=#3d2d00;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="760" width="350" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p4-repo" value="目标资源库&#xa;本地文件系统后端当前是可写主路径&#xa;插件源后端可扩展为 WebDAV / cloud&#xa;所有写入仍走核心确认、审计与 revision 路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#2da44e;fontColor=#116329;arcSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="760" width="310" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="p4-e1" value="build/package/stage" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#bf3989;" edge="1" parent="1" source="p4-plugin-src" target="p4-build">
