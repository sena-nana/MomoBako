{
  "pluginId": "momobako.service.office-convert",
  "build": {
    "type": "cargo-native",
    "sourceDir": "src",
    "manifestPath": "Cargo.toml",
    "outputDir": ".dist/office-convert",
    "excludePaths": [
      "helper",
      "Cargo.toml",
      "Cargo.lock",
      "src/lib.rs"
    ],
    "extraBinaries": [
      {
        "manifestPath": "helper/Cargo.toml",
        "binaryName": "office-convert-helper",
        "outputName": "office-convert-helper.exe"
      }
    ]
  }
}
