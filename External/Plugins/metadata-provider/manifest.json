{
  "pluginId": "momobako.metadata-provider",
  "name": "Metadata Provider",
  "version": "1.0.0",
  "type": {
    "layer": "provider-service",
    "kind": "metadata"
  },
  "kind": "metadata",
  "category": "service",
  "description": "提供可扩展的元数据生成与写入能力。",
  "capabilities": ["metadata", "tags", "ocr"],
  "enabled": false,
  "sdk": "backend",
  "runtime": "manifest-only",
  "entry": {},
  "permissions": ["filesystem:read"],
  "requires": [],
  "optional": ["momobako.service.network-search"],
  "hooks": [
    { "slot": "candidateQueue", "action": "service.metadata.writeCandidates", "label": "写入元数据候选" },
    { "slot": "metadataMerge", "action": "service.metadata.mergeCandidates", "label": "合并元数据候选" }
  ],
  "contributes": {
    "service": {
      "type": "metadata-provider",
      "candidateOnly": true
    }
  },
  "compat": {
    "sdkVersion": "1",
    "legacyPluginIds": []
  },
  "source": "builtin",
  "status": "disabled"
}
