{
  "pluginId": "momobako.preview.office",
  "name": "Office & PDF Preview",
  "version": "1.0.0",
  "type": {
    "layer": "library-kind",
    "kind": "preview"
  },
  "kind": "preview",
  "category": "preview",
  "description": "为 Microsoft Office 文档与 PDF 文件提供预览，并生成文档缩略图。",
  "capabilities": ["preview", "thumbnail", "pdf", "office", "word", "excel", "powerpoint"],
  "enabled": true,
  "sdk": "frontend",
  "runtime": "vue-module",
  "entry": {
    "frontend": {
      "module": "dist/register.js",
      "export": "register"
    }
  },
  "permissions": ["preview:read", "thumbnail:write"],
  "requires": [],
  "optional": ["momobako.service.office-convert", "momobako.parser.ebook"],
  "hooks": [
    { "slot": "progress", "action": "preview.office.reportReadPosition", "label": "更新阅读进度" }
  ],
  "contributes": {
    "preview": {
      "extensions": ["pdf", "doc", "docx", "docm", "dotx", "dotm", "dot", "xls", "xlsx", "xlsm", "xlsb", "xltx", "xltm", "xlt", "ppt", "pptx", "pptm", "ppsx", "ppsm", "pps", "potx", "potm", "pot"],
      "thumbnail": true
    }
  },
  "compat": {
    "sdkVersion": "1",
    "legacyPluginIds": []
  },
  "source": "builtin",
  "status": "ready"
}
