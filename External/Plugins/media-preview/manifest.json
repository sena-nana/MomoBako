{
  "pluginId": "momobako.preview.media",
  "legacyPluginIds": ["builtin.media-preview"],
  "name": "Media Preview",
  "version": "1.0.0",
  "type": {
    "layer": "library-kind",
    "kind": "preview"
  },
  "kind": "preview",
  "category": "preview",
  "description": "登记图片幻灯片和视频顺序播放两种播放集类型，由宿主播放。",
  "capabilities": ["preview", "playlist", "media", "image", "video"],
  "enabled": true,
  "sdk": "backend",
  "runtime": "manifest-only",
  "entry": {},
  "contributes": {
    "playlistPlayers": [
      {
        "playerTypeId": "momobako.playlist.image-slideshow",
        "label": "图片幻灯片",
        "fileClass": "image",
        "supportedExtensions": ["png", "jpg", "jpeg", "webp", "gif", "bmp", "avif", "svg"],
        "supportsSeek": false,
        "supportsVolume": false,
        "supportsPreviewNavigation": true,
        "description": "按顺序展示图片并交由宿主处理队列模式。"
      },
      {
        "playerTypeId": "momobako.playlist.video-sequence",
        "label": "视频顺序播放",
        "fileClass": "video",
        "supportedExtensions": ["mp4", "mov", "mkv", "webm", "avi", "m4v"],
        "supportsSeek": true,
        "supportsVolume": true,
        "supportsPreviewNavigation": true,
        "description": "复用媒体能力播放视频队列。"
      }
    ]
  },
  "permissions": ["preview:read"],
  "requires": [],
  "optional": ["momobako.parser.image", "momobako.parser.video"],
  "hooks": [
    { "slot": "playlist", "action": "preview.media.enqueue", "label": "加入播放列表" },
    { "slot": "pip", "action": "preview.media.openPip", "label": "画中画" },
    { "slot": "progress", "action": "preview.media.reportProgress", "label": "更新播放进度" }
  ],
  "compat": {
    "sdkVersion": "1",
    "legacyPluginIds": ["builtin.media-preview"]
  },
  "source": "builtin",
  "status": "ready"
}
