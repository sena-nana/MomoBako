{
  "pluginId": "momobako.preview.media",
  "legacyPluginIds": ["builtin.media-preview"],
  "name": "Media Preview",
  "version": "1.0.0",
  "type": {
    "layer": "library-kind",
    "kind": "preview"
  },
  "kind": "preview",
  "category": "preview",
  "description": "为常见视频与音频文件提供内联播放预览。",
  "capabilities": ["preview", "media", "video", "audio"],
  "enabled": true,
  "sdk": "frontend",
  "runtime": "vue-module",
  "entry": {
    "frontend": {
      "module": "dist/register.js",
      "export": "register"
    }
  },
  "permissions": ["preview:read"],
  "requires": [],
  "optional": ["momobako.parser.audio", "momobako.parser.video"],
  "hooks": [
    { "slot": "playlist", "action": "preview.media.enqueue", "label": "加入播放列表" },
    { "slot": "pip", "action": "preview.media.openPip", "label": "画中画" },
    { "slot": "progress", "action": "preview.media.reportProgress", "label": "更新播放进度" }
  ],
  "contributes": {
    "preview": {
      "extensions": ["png", "jpg", "jpeg", "webp", "gif", "bmp", "avif", "svg", "mp4", "mov", "mkv", "webm", "avi", "m4v", "mp3", "wav", "ogg", "flac", "m4a", "aac", "opus"],
      "thumbnail": false
    }
  },
  "compat": {
    "sdkVersion": "1",
    "legacyPluginIds": ["builtin.media-preview"]
  },
  "source": "builtin",
  "status": "ready"
}
