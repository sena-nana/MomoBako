{
  "pluginId": "momobako.local-filesystem",
  "legacyPluginIds": ["builtin.local-filesystem"],
  "name": "Local Filesystem",
  "version": "1.0.0",
  "type": {
    "layer": "source",
    "kind": "filesystem"
  },
  "kind": "filesystem",
  "category": "source",
  "description": "使用本地目录作为仓库文件管理后端。",
  "capabilities": ["browse", "read", "write", "watch", "sync"],
  "enabled": true,
  "sdk": "backend",
  "runtime": "native-dylib",
  "entry": {
    "backend": {
      "library": "momobako_builtin_local_filesystem"
    }
  },
  "permissions": ["filesystem:read", "filesystem:write"],
  "requires": [],
  "optional": ["momobako.filesystem-watcher"],
  "hooks": [],
  "contributes": {
    "settings": {
      "schemaVersion": 1,
      "settingsPage": {
        "label": "本地文件系统",
        "description": "配置本地资源库的文件检索方式。",
        "order": 10
      },
      "fields": [
        {
          "key": "fileSearchMode",
          "label": "文件检索方式",
          "type": "select",
          "description": "NTFS 与 Everything 不可用时会自动回退到现有扫描。",
          "default": "recursive",
          "options": [
            { "label": "现有扫描", "value": "recursive" },
            { "label": "NTFS 索引", "value": "ntfs" },
            { "label": "Everything 索引", "value": "everything" }
          ]
        }
      ]
    },
    "apiTests": [
      {
        "method": "filesystem.ensureAttachable",
        "summary": "检查本地目录是否可作为仓库挂载。",
        "payload": {
          "repoRoot": "<absoluteRepositoryPath>",
          "config": {}
        }
      },
      {
        "method": "filesystem.prepareRepositoryRoot",
        "summary": "准备本地仓库根目录。",
        "payload": {
          "repoRoot": "<absoluteRepositoryPath>",
          "config": {}
        }
      },
      {
        "method": "filesystem.listFiles",
        "summary": "递归列出本地仓库文件。",
        "payload": {
          "repoRoot": "<absoluteRepositoryPath>",
          "config": {}
        }
      },
      {
        "method": "filesystem.listTree",
        "summary": "读取本地仓库目录树。",
        "payload": {
          "repoRoot": "<absoluteRepositoryPath>",
          "config": {}
        }
      },
      {
        "method": "filesystem.listDirectory",
        "summary": "列出本地仓库单个目录。",
        "payload": {
          "repoRoot": "<absoluteRepositoryPath>",
          "directoryPath": "",
          "config": {}
        }
      },
      {
        "method": "filesystem.createDirectory",
        "summary": "创建本地目录。",
        "payload": {
          "repoRoot": "<absoluteRepositoryPath>",
          "parentPath": "",
          "name": "New Folder",
          "config": {}
        }
      },
      {
        "method": "filesystem.createFile",
        "summary": "创建本地文件。",
        "payload": {
          "repoRoot": "<absoluteRepositoryPath>",
          "parentPath": "",
          "name": "new-file.txt",
          "config": {}
        }
      },
      {
        "method": "filesystem.statEntry",
        "summary": "读取本地文件条目状态。",
        "payload": {
          "repoRoot": "<absoluteRepositoryPath>",
          "entryPath": "<relativePath>",
          "config": {}
        }
      },
      {
        "method": "filesystem.renameEntry",
        "summary": "重命名本地文件条目。",
        "payload": {
          "repoRoot": "<absoluteRepositoryPath>",
          "sourcePath": "<relativePath>",
          "newName": "renamed.txt",
          "config": {}
        }
      },
      {
        "method": "filesystem.moveEntry",
        "summary": "移动本地文件条目。",
        "payload": {
          "repoRoot": "<absoluteRepositoryPath>",
          "sourcePath": "<relativePath>",
          "targetParentPath": "",
          "config": {}
        }
      },
      {
        "method": "filesystem.deleteEntry",
        "summary": "删除本地文件条目。",
        "payload": {
          "repoRoot": "<absoluteRepositoryPath>",
          "entryPath": "<relativePath>",
          "recursive": false,
          "config": {}
        }
      }
    ],
    "source": {
      "operations": ["list", "read", "write", "move", "delete", "watch"],
      "dangerousOperations": ["write", "move", "delete"]
    }
  },
  "compat": {
    "sdkVersion": "1",
    "legacyPluginIds": ["builtin.local-filesystem"]
  },
  "source": "builtin",
  "status": "ready"
}
