{
  "pluginId": "momobako.library.asmr",
  "legacyPluginIds": [
    "builtin.library-asmr"
  ],
  "name": "ASMR Library",
  "version": "0.2.0",
  "type": {
    "layer": "library-kind",
    "kind": "asmr"
  },
  "kind": "library-kind",
  "category": "library-kind",
  "description": "为 ASMR 与同人音声作品声明 RJ 目录识别、作品字段、音轨视图、播放进度、搜索筛选和整理候选。",
  "capabilities": [
    "library-kind",
    "metadata-schema",
    "view-presets",
    "playlist",
    "progress",
    "search",
    "metadata-merge",
    "organize-candidates"
  ],
  "enabled": true,
  "sdk": "frontend",
  "entry": {
    "frontend": {
      "module": "src/register.js",
      "export": "register"
    }
  },
  "source": "builtin",
  "runtime": "vue-module",
  "permissions": [
    "readRepository",
    "readMetadata",
    "writeCandidates",
    "suggestRename",
    "suggestMove"
  ],
  "requires": [],
  "optional": [
    "momobako.parser.audio",
    "momobako.parser.asmr-folder",
    "momobako.preview.media",
    "momobako.service.network-search",
    "momobako.service.provider.dlsite",
    "momobako.service.provider.asmr-one"
  ],
  "hooks": [
    {
      "slot": "playlist",
      "action": "library.asmr.enqueueWorkTracks",
      "label": "加入播放列表"
    },
    {
      "slot": "playlist",
      "action": "library.asmr.enqueueRandomWork",
      "label": "随心听"
    },
    {
      "slot": "progress",
      "action": "library.asmr.trackListeningProgress",
      "label": "记录收听进度"
    },
    {
      "slot": "search",
      "action": "library.asmr.applySearchFacets",
      "label": "ASMR 检索筛选"
    },
    {
      "slot": "metadataMerge",
      "action": "library.asmr.mergeProviderCandidates",
      "label": "合并作品元数据候选"
    },
    {
      "slot": "batchOrganize",
      "action": "library.asmr.suggestWorkLayout",
      "label": "生成作品整理候选"
    }
  ],
  "contributes": {
    "libraryExtension": {
      "libraryKind": "asmr",
      "entry": "src/register.js",
      "slots": [
        "metadataPanel",
        "previewPanel",
        "fileSummary",
        "searchShortcuts",
        "playlist"
      ],
      "searchShortcuts": [
        "works",
        "lyrics",
        "continue",
        "random"
      ]
    },
    "libraryKind": {
      "id": "asmr",
      "recognition": {
        "folderPattern": "(?i)RJ\\d{6,8}",
        "scope": "folder",
        "duplicatePolicy": "candidate-warning",
        "nonMatchingFolderPolicy": "recurse"
      },
      "fields": [
        "libraryKind",
        "workId",
        "rjCode",
        "title",
        "workTitle",
        "circle",
        "creator",
        "voiceActors",
        "characters",
        "series",
        "scenarioTags",
        "audioTraits",
        "nsfw",
        "ageRating",
        "language",
        "releaseDate",
        "price",
        "dlCount",
        "reviewCount",
        "rateCount",
        "rateAverage",
        "rateCountDetail",
        "rank",
        "cover",
        "coverSourceWorkId",
        "sourceUrl",
        "purchaseSource",
        "workRoot",
        "trackPath",
        "trackTitle",
        "trackCount",
        "trackDurationMs",
        "durationMs",
        "lyricStatus",
        "listeningStatus",
        "listeningProgress",
        "lastListenedAt",
        "comment",
        "rating"
      ],
      "facets": [
        "circle",
        "voiceActors",
        "series",
        "scenarioTags",
        "audioTraits",
        "language",
        "nsfw",
        "lyricStatus",
        "listeningStatus"
      ],
      "sortFields": [
        "releaseDate",
        "dlCount",
        "price",
        "rateAverage",
        "reviewCount",
        "rating",
        "addedToLibraryAt",
        "lastListenedAt",
        "durationMs",
        "trackCount"
      ],
      "views": [
        "works",
        "tracks",
        "circles",
        "voiceActors",
        "series",
        "withLyrics",
        "continueListening",
        "marked",
        "missingMetadata",
        "duplicateWorks"
      ],
      "search": {
        "keywordFields": [
          "workId",
          "rjCode",
          "title",
          "workTitle",
          "circle",
          "voiceActors",
          "scenarioTags"
        ],
        "advancedConditionMode": "and"
      },
      "progress": {
        "statusField": "listeningStatus",
        "positionField": "listeningProgress",
        "lastOpenedField": "lastListenedAt",
        "statusValues": [
          "marked",
          "listening",
          "listened",
          "replay",
          "postponed",
          "unlistened"
        ]
      },
      "organize": {
        "workFolderTemplate": "{rjCode} {title}",
        "trackSort": "natural",
        "candidateOnly": true
      },
      "preview": [
        "momobako.preview.media"
      ]
    }
  },
  "compat": {
    "sdkVersion": "1",
    "legacyPluginIds": [
      "builtin.library-asmr"
    ]
  },
  "status": "ready"
}
