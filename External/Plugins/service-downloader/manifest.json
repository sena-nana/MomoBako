{
  "pluginId": "momobako.service.downloader",
  "legacyPluginIds": [
    "builtin.service-downloader"
  ],
  "name": "Download Service",
  "version": "0.1.0",
  "type": {
    "layer": "provider-service",
    "kind": "download"
  },
  "kind": "download",
  "category": "service",
  "description": "提供播放临时下载、音频歌词导出与歌单批量下载能力。",
  "capabilities": [
    "download",
    "download-queue",
    "playback-temp",
    "lyrics",
    "runtime"
  ],
  "enabled": true,
  "sdk": "backend",
  "runtime": "native-dylib",
  "entry": {
    "backend": {
      "library": "momobako_service_downloader"
    }
  },
  "permissions": [
    "network",
    "filesystem:write",
    "filesystem:read"
  ],
  "requires": [],
  "optional": [],
  "hooks": [],
  "contributes": {
    "apiTests": [
      {
        "method": "downloader.prepareTrackPlayback",
        "summary": "下载单曲到临时目录并返回可播放路径。",
        "payload": {
          "accountCookie": "",
          "songId": 0,
          "level": "standard",
          "repoId": "repo-demo",
          "entryPath": "Songs/demo.mp3",
          "sourcePayload": {}
        }
      },
      {
        "method": "downloader.downloadTrackPackage",
        "summary": "下载单曲与歌词到目标目录。",
        "payload": {
          "accountCookie": "",
          "songId": 0,
          "level": "standard",
          "destination": {
            "kind": "directory",
            "path": "./tmp/momobako-track-package"
          },
          "sourcePayload": {}
        }
      },
      {
        "method": "downloader.downloadPlaylistPackage",
        "summary": "批量下载歌单到目标目录。",
        "payload": {
          "accountCookie": "",
          "playlistId": 0,
          "tracks": [],
          "level": "standard",
          "destination": {
            "kind": "directory",
            "path": "./tmp/momobako-playlist-package"
          },
          "sourcePayload": {}
        }
      },
      {
        "method": "downloader.resolveLyrics",
        "summary": "读取单曲歌词与逐字歌词。",
        "payload": {
          "accountCookie": "",
          "songId": 0
        }
      },
      {
        "method": "downloader.clearTrackCache",
        "summary": "清理单曲临时缓存。",
        "payload": {
          "songId": 0,
          "level": "standard"
        }
      },
      {
        "method": "downloader.getRuntimeStatus",
        "summary": "读取下载运行时状态。",
        "payload": {}
      },
      {
        "method": "downloader.ensureRuntime",
        "summary": "确保 aria2 下载运行时可用。",
        "payload": {}
      },
      {
        "method": "downloader.enqueueDownload",
        "summary": "创建一个通用下载任务。",
        "payload": {
          "url": "https://example.invalid/archive.zip",
          "destinationPath": "./tmp/momobako-downloader-test.zip",
          "metadata": {
            "kind": "api-test"
          }
        }
      },
      {
        "method": "downloader.awaitDownload",
        "summary": "等待一个通用下载任务完成。",
        "payload": {
          "taskId": "task-demo"
        }
      },
      {
        "method": "downloader.removeDownload",
        "summary": "移除一个通用下载任务。",
        "payload": {
          "taskId": "task-demo"
        }
      }
    ],
    "settings": {
      "schemaVersion": 1,
      "settingsPage": {
        "label": "下载服务"
      },
      "fields": [
        {
          "key": "apiBaseUrl",
          "label": "API Base URL",
          "type": "string",
          "description": "留空时使用 ncm-api-rs 内置的网易云官方域名；仅在需要自定义域名时填写。",
          "default": ""
        },
        {
          "key": "defaultLevel",
          "label": "默认音质",
          "type": "select",
          "default": "standard",
          "options": [
            { "label": "标准", "value": "standard" },
            { "label": "较高", "value": "higher" },
            { "label": "极高", "value": "exhigh" },
            { "label": "无损", "value": "lossless" }
          ]
        },
        {
          "key": "tempTtlMinutes",
          "label": "临时缓存分钟数",
          "type": "number",
          "default": 120,
          "min": 5,
          "max": 1440
        },
        {
          "key": "filenameTemplate",
          "label": "文件名模板",
          "type": "string",
          "default": "{{artists}} - {{songName}}"
        }
      ]
    }
  },
  "compat": {
    "sdkVersion": "1",
    "legacyPluginIds": [
      "builtin.service-downloader"
    ]
  },
  "source": "builtin",
  "status": "ready"
}
