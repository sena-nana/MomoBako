{
  "pluginId": "momobako.service.downloader",
  "legacyPluginIds": ["builtin.service-downloader"],
  "name": "Download Service",
  "version": "0.2.0",
  "type": { "layer": "provider-service", "kind": "download" },
  "kind": "download",
  "category": "service",
  "description": "提供 aria2 通用下载队列与运行时管理。",
  "capabilities": ["download", "download-queue", "runtime"],
  "enabled": true,
  "sdk": "backend",
  "runtime": "native-dylib",
  "entry": { "backend": { "library": "momobako_service_downloader" } },
  "permissions": ["network", "filesystem:write", "filesystem:read"],
  "requires": [],
  "optional": [],
  "hooks": [],
  "contributes": {
    "apiTests": [
      { "method": "downloader.getRuntimeStatus", "summary": "读取下载运行时状态。", "payload": {} },
      { "method": "downloader.ensureRuntime", "summary": "确保 aria2 下载运行时可用。", "payload": {} },
      {
        "method": "downloader.enqueueDownload",
        "summary": "创建通用下载任务。",
        "payload": {
          "url": "https://example.invalid/archive.zip",
          "destinationPath": "./tmp/momobako-downloader-test.zip",
          "metadata": { "kind": "api-test" }
        }
      },
      { "method": "downloader.awaitDownload", "summary": "等待通用下载任务。", "payload": { "taskId": "task-demo" } },
      { "method": "downloader.removeDownload", "summary": "移除通用下载任务。", "payload": { "taskId": "task-demo" } }
    ],
    "settings": {
      "schemaVersion": 1,
      "settingsPage": { "label": "下载服务" },
      "fields": []
    }
  },
  "compat": { "sdkVersion": "1", "legacyPluginIds": ["builtin.service-downloader"] },
  "source": "builtin",
  "status": "ready"
}
