{
  "name": "momobako",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:backend": "cargo test -p momobako-backend --locked",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "plugins:build": "node scripts/build-external-plugins.mjs",
    "plugins:build:dev": "node scripts/build-external-plugins.mjs --profile dev",
    "plugins:package": "node scripts/package-external-plugins.mjs",
    "nana:build": "cargo build -p momobako-nana --bin momobako-nana --profile dist --locked",
    "nana:package": "node scripts/nana-package.ts",
    "icons:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "typecheck:node-scripts": "tsc --project tsconfig.node-scripts.json",
    "verify": "yarn typecheck:node-scripts && yarn test && cargo check -p momobako-backend -p momobako-nana --all-targets --locked",
    "test:nana:offscreen": "bash scripts/run-nana-offscreen-acceptance.sh"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "~6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697",
  "engines": {
    "node": ">=26.0.0 <27"
  }
}
