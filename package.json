    "vue-router": "^5.0.7",
    "vue3-markdown-it": "^1.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
